sigma = matrix(NA, p, p)
for(i in 1:p){
for(j in 1:p){
sigma[i,j] = theta[j,j]*theta[i,i] + theta[i,j]^2
}
}
return(list(theta, T_hat, sigma))
}
end <-Sys.time()
stopCluster(cl)
end-start # approx 26 seconds
