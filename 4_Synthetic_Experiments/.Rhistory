registerDoRNG(seed = 2)
res <- foreach(j=t96, .packages = c("Matrix","phonTools", "QZ", "purrr", "matrixStats", "complexplus",
"psych", "pracma", "hawkes")) %dopar%{
Max_iter = 1000;
