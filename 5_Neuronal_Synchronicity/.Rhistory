coherence_function = function(mat){
co = matrix(NA, nrow = nrow(mat), ncol=ncol(mat));
for(i in 1:nrow(mat)){
for(j in 1:nrow(mat)){
co[i,j] = (Mod(mat[i,j])^2) / ( mat[i,i]*mat[j,j] )
}
}
return(co)
}
plot_mat = function(mat, limit, legend_fill, title){
# Convert matrix to data frame
df <- melt(mat)
colnames(df) <- c("row", "col", "value")
# Plot with ggplot2
ggplot(df, aes(x=col, y=row, fill=value)) +
geom_tile() +
scale_fill_gradient2(low="white", high="red", limits=c(0, limit)) +
scale_y_reverse() +  # Reverse y-axis for top-left origin
theme_minimal() +
labs(x="Neuron ID", y="Neuron ID", fill=legend_fill,
axis.text.x = element_text(size=16))+
ggtitle(title)
}
