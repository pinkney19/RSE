boot_means = NULL;
for(b in 1:B){
sample_b = sample(cor, size = length(cor), replace = T)
boot_means[b] = mean(sample_b)
}
skewness[i] = skewness(boot_means)
excess_kurt[i] = kurtosis(boot_means)-3
}
return(list(skew=skewness, kurt = excess_kurt))
}
