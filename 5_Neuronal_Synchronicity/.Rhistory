plot_thresholded_co = function(cap_length, S_hat_band, band_no){
# estimate coherence at each frequency
est_co_band = lapply(S_hat_band, coherence_function)
# get averaged estimate
avg_band = Reduce("+", est_co_band)/length(est_co_band)
# set diag to NA
diag(avg_band)=NA
# plot non-thresholded version
plt1 = plot_mat(Re(avg_band), round(max(Re(avg_band)), 2), "", band_no)
# threshold based on no. edges in correlaation matrix
check2 = as.numeric(Re(avg_band))
# select cut-off
cut_off = min(sort(check2, decreasing = T)[1:caplength])
avg_band = Re(avg_band)
# set values below cut-off to zero
avg_band[avg_band<cut_off]=0
# plot thresholded coherence
plt=plot_mat(avg_band, round(max(avg_band), 2),"", band_no)
return(list(co=avg_band, plt1 = plt1, plt2 = plt))
}
